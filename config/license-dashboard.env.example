# Copy this file to:
#   config/license-dashboard.env
# then fill in your real values.

# Dashboard server
LICENSE_DASHBOARD_PORT=8787
# Show orders in dashboard only after buyer submits payment reference.
LICENSE_DASHBOARD_REQUIRE_PAYMENT_REF=true

# Optional manual GCash details shown to buyers
LICENSE_GCASH_NAME=
LICENSE_GCASH_NUMBER=
LICENSE_GCASH_QR_URL=
LICENSE_PRICE_PHP=299
LICENSE_DEFAULT_DAYS=30
# Plan format: code|label|days|amountPhp;code|label|days|amountPhp
LICENSE_CHECKOUT_PLANS=1m|1 Month|30|100;3m|3 Months|90|270;6m|6 Months|180|480;1y|1 Year|365|840

# Optional dashboard security tokens (recommended)
LICENSE_DASHBOARD_ADMIN_TOKEN=
LICENSE_WEBHOOK_SECRET=
LICENSE_PUBLIC_API_TOKEN=
MFPH_LOCAL_LICENSE_SECRET=change_this_same_value_for_dashboard_and_app

# Buyer email receipt notifications (SMTP)
LICENSE_EMAIL_ENABLED=true
LICENSE_SMTP_HOST=smtp.gmail.com
LICENSE_SMTP_PORT=587
LICENSE_SMTP_SECURE=false
LICENSE_SMTP_USER=your_sender_email@gmail.com
LICENSE_SMTP_PASS=your_app_password
LICENSE_EMAIL_FROM_NAME=Mohon Finder PH
LICENSE_EMAIL_FROM_ADDRESS=your_sender_email@gmail.com
LICENSE_EMAIL_REPLY_TO=
LICENSE_EMAIL_SUBJECT_PREFIX=Mohon Finder PH
LICENSE_OWNER_NOTIFY_EMAIL=owner@example.com
LICENSE_OWNER_NOTIFY_ON_NEW_ORDER=true
LICENSE_OWNER_NOTIFY_ON_PAID=true
LICENSE_OWNER_NOTIFY_ON_FAILED=true

# PayMongo automation
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_SUCCESS_URL=https://example.com/payment-success
PAYMONGO_CANCEL_URL=https://example.com/payment-cancelled
PAYMONGO_WEBHOOK_SECRET_KEY=whsk_test_xxxxxxxxxxxxxxxxx
PAYMONGO_MODE=test
PAYMONGO_SIGNATURE_TOLERANCE_SEC=300
